# /api is proxied to the payments API by Vite (see vite.config.ts) to avoid CORS
VITE_API_BASE=/api
# Bearer token from the challenge PDF
VITE_API_TOKEN=
# false = real API (needs the token above). true = local mock data, no network (src/api/mockPayments.ts)
VITE_USE_MOCK=false
# Optional, mock only: fraction of calls that fail (e.g. 0.1) to test retry/error UI
VITE_MOCK_FAIL_RATE=0
